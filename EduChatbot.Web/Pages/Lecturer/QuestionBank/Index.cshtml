@page
@model EduChatbot.Web.Pages.Lecturer.QuestionBank.IndexModel
@{
    ViewData["Title"] = "Question Bank";
}

<style>
    .qb-search-input::placeholder {
        color: var(--edu-muted) !important;
        opacity: 0.95 !important;
    }
    .qb-search-icon-wrapper {
        color: var(--edu-text) !important;
        opacity: 0.9 !important;
    }
    .qb-search-input,
    .qb-search-icon-wrapper {
        background-color: rgba(228, 240, 246, 0.05) !important;
        border-color: var(--edu-border) !important;
    }
</style>

<section class="role-page">
    <!-- Page Header -->
    <header class="role-hero compact">
        <div>
            <div class="role-kicker" data-i18n="questionBank.kicker">PORTAL NGÂN HÀNG ĐỀ</div>
            <h1 class="fw-bold" data-i18n="questionBank.title">Ngân Hàng Câu Hỏi</h1>
            <p style="color: var(--edu-muted);" data-i18n="questionBank.subtitle">Quản lý câu hỏi trắc nghiệm tự soạn hoặc được sinh tự động bằng AI từ tài liệu môn học.</p>
        </div>
        <div class="role-header-actions" style="display: flex; gap: 0.5rem; align-items: center;">
            <a asp-page="/Lecturer/Quizzes/Index" class="role-secondary-btn d-inline-flex align-items-center gap-2">
                <i class="bi bi-card-checklist"></i> <span data-i18n="questionBank.manageQuizzesBtn">Quản lý đề trắc nghiệm</span>
            </a>
            <a asp-page="./Create" class="role-primary-btn d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border: none;">
                <i class="bi bi-plus-lg"></i> <span data-i18n="questionBank.addManualBtn">Thêm câu hỏi thủ công</span>
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="role-alert success" style="margin-bottom: 1.5rem;">
            <strong>@TempData["SuccessMessage"]</strong>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="role-alert danger" style="margin-bottom: 1.5rem;">
            <strong>@TempData["ErrorMessage"]</strong>
        </div>
    }

    <!-- Filtering Toolbar Card -->
    <div class="role-form-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold" style="color: var(--edu-text);" data-i18n="questionBank.searchLabel">Tìm kiếm câu hỏi</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 qb-search-icon-wrapper">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" asp-for="Filter.SearchQuery" class="form-control border-start-0 ps-0 text-white qb-search-input" placeholder="Từ khóa câu hỏi, giải thích..." data-i18n-placeholder="questionBank.searchPlaceholder" style="color: #fff;" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold" style="color: var(--edu-text);" data-i18n="questionBank.courseLabel">Môn học</label>
                <select asp-for="Filter.CourseId" class="form-select text-white" style="background: rgba(228, 240, 246, 0.03) url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3e%3cpath fill=%27none%27 stroke=%27%23ffffff%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27m2 5 6 6 6-6%27/%3e%3c/svg%3e') no-repeat right 0.75rem center/8px 10px; border: 1px solid var(--edu-border);" asp-items="@(new SelectList(Model.Courses, "Id", "Code"))">
                    <option value="" style="background: var(--edu-bg); color: #fff;">-- Tất cả môn --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold" style="color: var(--edu-text);" data-i18n="questionBank.documentLabel">Tài liệu nguồn</label>
                <select asp-for="Filter.DocumentId" class="form-select text-white" style="background: rgba(228, 240, 246, 0.03) url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3e%3cpath fill=%27none%27 stroke=%27%23ffffff%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27m2 5 6 6 6-6%27/%3e%3c/svg%3e') no-repeat right 0.75rem center/8px 10px; border: 1px solid var(--edu-border);" asp-items="@(new SelectList(Model.Documents, "Id", "FileName"))">
                    <option value="" style="background: var(--edu-bg); color: #fff;">-- Tất cả tài liệu --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold" style="color: var(--edu-text);" data-i18n="questionBank.difficultyLabel">Độ khó</label>
                <select asp-for="Filter.Difficulty" class="form-select text-white" style="background: rgba(228, 240, 246, 0.03) url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3e%3cpath fill=%27none%27 stroke=%27%23ffffff%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27m2 5 6 6 6-6%27/%3e%3c/svg%3e') no-repeat right 0.75rem center/8px 10px; border: 1px solid var(--edu-border);">
                    <option value="" style="background: var(--edu-bg); color: #fff;">-- Tất cả --</option>
                    <option value="Easy" style="background: var(--edu-bg); color: #fff;">Dễ (Easy)</option>
                    <option value="Medium" style="background: var(--edu-bg); color: #fff;">Trung bình (Medium)</option>
                    <option value="Hard" style="background: var(--edu-bg); color: #fff;">Khó (Hard)</option>
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label fw-semibold" style="color: var(--edu-text);" data-i18n="questionBank.statusLabel">Trạng thái</label>
                <select asp-for="Filter.Status" class="form-select text-white" style="background: rgba(228, 240, 246, 0.03) url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3e%3cpath fill=%27none%27 stroke=%27%23ffffff%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27m2 5 6 6 6-6%27/%3e%3c/svg%3e') no-repeat right 0.75rem center/8px 10px; border: 1px solid var(--edu-border);">
                    <option value="" style="background: var(--edu-bg); color: #fff;">-- Tất cả --</option>
                    <option value="Draft" style="background: var(--edu-bg); color: #fff;">Bản nháp</option>
                    <option value="Approved" style="background: var(--edu-bg); color: #fff;">Đã duyệt</option>
                    <option value="Archived" style="background: var(--edu-bg); color: #fff;">Đã lưu trữ</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="role-primary-btn flex-fill" style="background: #10b981; border: none; color: #fff; width: 100%;">
                    <i class="bi bi-funnel-fill"></i> <span data-i18n="questionBank.filterBtn">Lọc</span>
                </button>
                <a asp-page="./Index" class="role-secondary-btn" style="min-width: 40px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Main List Card -->
    <div class="role-table-card" style="margin-bottom: 1.5rem; overflow: hidden; border-radius: 12px; background: rgba(228, 240, 246, 0.02); border: 1px solid var(--edu-border);">
        <div style="padding: 1rem 1.5rem; background: rgba(228, 240, 246, 0.03); border-bottom: 1px solid var(--edu-border); display: flex; align-items: center; justify-content: space-between;">
            <h5 class="m-0 fw-bold d-flex align-items-center gap-2" style="color: var(--edu-text); font-size: 1.1rem;">
                <i class="bi bi-database-fill text-primary"></i> <span data-i18n="questionBank.listTitle">Danh sách câu hỏi</span> (@Model.Questions.TotalCount)
            </h5>
            <div id="selection-toolbar" class="d-none">
                <button type="button" class="role-primary-btn" style="background: #f59e0b; border-color: #f59e0b; color: #fff; height: 36px; padding: 0 1rem; border-radius: 6px; font-size: 0.9rem;" onclick="createQuizFromSelection()">
                    <i class="bi bi-magic"></i> <span data-i18n="questionBank.createQuizBtn">Tạo bài trắc nghiệm từ câu hỏi đã chọn</span> (<span id="select-count">0</span>)
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--edu-border); background: rgba(228, 240, 246, 0.015);">
                        <th style="width: 40px;" class="text-center">
                            <input type="checkbox" id="check-all" class="form-check-input" onclick="toggleSelectAll(this)" style="cursor: pointer;" />
                        </th>
                        <th data-i18n="questionBank.colQuestion">Nội dung câu hỏi</th>
                        <th style="width: 120px;" data-i18n="questionBank.colCourse">Môn học</th>
                        <th style="width: 140px;" data-i18n="questionBank.colDiff">Độ khó</th>
                        <th style="width: 120px;" data-i18n="questionBank.colStatus">Trạng thái</th>
                        <th style="width: 140px;" data-i18n="questionBank.colSource">Nguồn</th>
                        <th style="width: 160px;" class="text-end" data-i18n="questionBank.colActions">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Questions.Items.Any())
                    {
                        @foreach (var item in Model.Questions.Items)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td class="text-center">
                                    @if (item.Status != "Archived")
                                    {
                                        <input type="checkbox" name="selectedIds" value="@item.Id" class="form-check-input question-checkbox" onclick="updateSelectionCount()" style="cursor: pointer;" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="form-check-input" disabled />
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-truncate" style="max-width: 450px; color: var(--edu-text);" title="@item.QuestionText">
                                        @item.QuestionText
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Tags))
                                    {
                                        <div class="mt-1 d-flex gap-1 flex-wrap">
                                            @foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge" style="background: rgba(228, 240, 246, 0.08); color: rgba(228, 240, 246, 0.7); font-size: 0.75rem; font-weight: 500;">@tag.Trim()</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge" style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2); font-weight: 600;">
                                        @item.CourseCode
                                    </span>
                                </td>
                                <td>
                                    @if (item.Difficulty == "Easy")
                                    {
                                        <span class="text-success fw-semibold"><i class="bi bi-circle-fill font-xs" style="font-size: 0.6rem; margin-right: 0.3rem;"></i>Dễ</span>
                                    }
                                    else if (item.Difficulty == "Medium")
                                    {
                                        <span class="text-warning fw-semibold"><i class="bi bi-circle-fill font-xs" style="font-size: 0.6rem; margin-right: 0.3rem;"></i>Trung bình</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold"><i class="bi bi-circle-fill font-xs" style="font-size: 0.6rem; margin-right: 0.3rem;"></i>Khó</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 30px;">Đã duyệt</span>
                                    }
                                    else if (item.Status == "Draft")
                                    {
                                        <span class="badge" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 30px;">Nháp</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: rgba(148, 163, 184, 0.1); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 30px;">Lưu trữ</span>
                                    }
                                </td>
                                <td>
                                    @if (item.SourceType == "AI")
                                    {
                                        <span class="text-info d-flex align-items-center gap-1 font-sm" title="Sinh từ tài liệu: @item.DocumentName">
                                            <i class="bi bi-cpu-fill"></i> AI Generated
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted d-flex align-items-center gap-1 font-sm">
                                            <i class="bi bi-person-fill"></i> Thủ công
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button type="button" class="role-secondary-btn btn-sm" style="min-height: 32px; padding: 0.25rem 0.5rem;" onclick="showQuestionDetails(@item.Id)" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        @if (item.Status != "Archived")
                                        {
                                            <a asp-page="./Edit" asp-route-id="@item.Id" class="role-secondary-btn btn-sm" style="min-height: 32px; padding: 0.25rem 0.5rem;" title="Sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirmDelete(event, this)" style="display: inline;">
                                                <button type="submit" class="role-secondary-btn btn-sm" style="min-height: 32px; padding: 0.25rem 0.5rem; border-color: rgba(239, 68, 68, 0.4); color: #ef4444;" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="role-secondary-btn btn-sm" style="min-height: 32px; padding: 0.25rem 0.5rem; opacity: 0.4;" disabled><i class="bi bi-pencil"></i></button>
                                            <button class="role-secondary-btn btn-sm" style="min-height: 32px; padding: 0.25rem 0.5rem; opacity: 0.4;" disabled><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5" style="color: var(--edu-muted);">
                                <i class="bi bi-inbox fs-1 d-block mb-3" style="color: var(--edu-soft);"></i>
                                <h5 class="fw-bold text-white mb-2" data-i18n="questionBank.emptyState">Chưa có câu hỏi nào được chọn hoặc tìm thấy phù hợp.</h5>
                                <p class="m-0 font-sm" style="max-width: 480px; margin: 0 auto; color: var(--edu-muted);" data-i18n="questionBank.emptyStateDesc">Hãy tạo câu hỏi thủ công hoặc lưu câu hỏi từ Quiz Review vào Ngân hàng câu hỏi.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (Model.Questions.TotalPages > 1)
        {
            <div style="padding: 1rem 1.5rem; background: rgba(228, 240, 246, 0.03); border-top: 1px solid var(--edu-border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
                <div class="font-sm" style="color: var(--edu-muted);">
                    Hiển thị trang @Model.Questions.Page trên tổng số @Model.Questions.TotalPages trang
                </div>
                <nav>
                    <ul class="pagination pagination-sm m-0">
                        <li class="page-item @(Model.Questions.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-page="./Index" asp-route-Filter.PageNumber="@(Model.Questions.Page - 1)"
                               asp-route-Filter.CourseId="@Model.Filter.CourseId" asp-route-Filter.DocumentId="@Model.Filter.DocumentId"
                               asp-route-Filter.Difficulty="@Model.Filter.Difficulty" asp-route-Filter.Status="@Model.Filter.Status"
                               asp-route-Filter.SearchQuery="@Model.Filter.SearchQuery" style="background: rgba(228, 240, 246, 0.03); border: 1px solid var(--edu-border); color: var(--edu-text);">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.Questions.TotalPages; i++)
                        {
                            <li class="page-item @(Model.Questions.Page == i ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-Filter.PageNumber="@i"
                                   asp-route-Filter.CourseId="@Model.Filter.CourseId" asp-route-Filter.DocumentId="@Model.Filter.DocumentId"
                                   asp-route-Filter.Difficulty="@Model.Filter.Difficulty" asp-route-Filter.Status="@Model.Filter.Status"
                                   asp-route-Filter.SearchQuery="@Model.Filter.SearchQuery" style="@(Model.Questions.Page == i ? "background: #f59e0b; border-color: #f59e0b; color: #fff;" : "background: rgba(228, 240, 246, 0.03); border: 1px solid var(--edu-border); color: var(--edu-text);")">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.Questions.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-page="./Index" asp-route-Filter.PageNumber="@(Model.Questions.Page + 1)"
                               asp-route-Filter.CourseId="@Model.Filter.CourseId" asp-route-Filter.DocumentId="@Model.Filter.DocumentId"
                               asp-route-Filter.Difficulty="@Model.Filter.Difficulty" asp-route-Filter.Status="@Model.Filter.Status"
                               asp-route-Filter.SearchQuery="@Model.Filter.SearchQuery" style="background: rgba(228, 240, 246, 0.03); border: 1px solid var(--edu-border); color: var(--edu-text);">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</section>

<!-- Details Modal -->
<div class="modal fade" id="questionDetailsModal" tabindex="-1" aria-hidden="true" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow border-0" style="background: #181c26; border: 1px solid var(--edu-border); border-radius: 16px; color: #fff;">
            <div class="modal-header py-3" style="border-bottom: 1px solid var(--edu-border);">
                <h5 class="modal-title fw-bold" id="modalQuestionTitle" style="color: #fff;" data-i18n="questionBank.modalTitle">Chi tiết câu hỏi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalQuestionBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleSelectAll(checkbox) {
            const checkboxes = document.querySelectorAll('.question-checkbox');
            checkboxes.forEach(cb => cb.checked = checkbox.checked);
            updateSelectionCount();
        }

        function updateSelectionCount() {
            const selected = document.querySelectorAll('.question-checkbox:checked');
            const count = selected.length;
            const toolbar = document.getElementById('selection-toolbar');
            const selectCountSpan = document.getElementById('select-count');

            if (count > 0) {
                toolbar.classList.remove('d-none');
                selectCountSpan.textContent = count;
            } else {
                toolbar.classList.add('d-none');
                document.getElementById('check-all').checked = false;
            }
        }

        function createQuizFromSelection() {
            const selected = document.querySelectorAll('.question-checkbox:checked');
            const ids = Array.from(selected).map(cb => cb.value);
            
            // Build the URL to CreateQuiz with SelectedQuestionIds
            const query = ids.map(id => 'selectedIds=' + id).join('&');
            window.location.href = './QuestionBank/CreateQuiz?' + query;
        }

        async function showQuestionDetails(id) {
            const modal = new bootstrap.Modal(document.getElementById('questionDetailsModal'));
            modal.show();

            const body = document.getElementById('modalQuestionBody');
            body.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            `;

            try {
                const response = await fetch(`./QuestionBank/Details?id=${id}&handler=DetailsData`);
                if (!response.ok) {
                    throw new Error("Lỗi tải thông tin chi tiết");
                }
                const data = await response.json();
                renderDetails(data, body);
            } catch (err) {
                body.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
            }
        }

        function renderDetails(data, container) {
            let optionsHtml = '';
            data.options.forEach(opt => {
                optionsHtml += `
                    <div class="p-3 mb-2 rounded border d-flex align-items-center gap-3" style="background: ${opt.isCorrect ? 'rgba(16, 185, 129, 0.1)' : 'rgba(255,255,255,0.02)'}; border-color: ${opt.isCorrect ? '#10b981' : 'var(--edu-border)'} !important; color: ${opt.isCorrect ? '#10b981' : 'var(--edu-text)'};">
                        <span class="badge rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; font-weight: bold; background: rgba(228,240,246,0.1) !important; color: #fff;">${opt.label}</span>
                        <div>${opt.optionText}</div>
                        ${opt.isCorrect ? '<span class="ms-auto text-success font-xs text-uppercase fw-bold"><i class="bi bi-check-circle-fill"></i> <span data-i18n="questionBank.modalCorrect">Đúng</span></span>' : ''}
                    </div>
                `;
            });

            container.innerHTML = `
                <div class="mb-4">
                    <h6 class="fw-bold font-xs text-uppercase mb-2" style="color: var(--edu-muted);" data-i18n="questionBank.modalQuestion">Câu hỏi</h6>
                    <div class="fs-5 fw-semibold" style="color: var(--edu-text);">${data.questionText}</div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold font-xs text-uppercase mb-2" style="color: var(--edu-muted);" data-i18n="questionBank.modalAnswers">Các phương án trả lời</h6>
                    ${optionsHtml}
                </div>

                ${data.explanation ? `
                <div class="mb-4 p-3 rounded" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2);">
                    <h6 class="fw-bold font-xs text-uppercase mb-1" style="color: #f59e0b;"><i class="bi bi-chat-left-text-fill"></i> <span data-i18n="questionBank.modalExplanation">Giải thích</span></h6>
                    <p class="m-0 font-sm" style="color: #ffd79a;">${data.explanation}</p>
                </div>
                ` : ''}

                <div class="row g-3 pt-3" style="border-top: 1px solid var(--edu-border);">
                    <div class="col-md-4">
                        <span class="font-xs d-block" style="color: var(--edu-muted);" data-i18n="questionBank.modalCourse">Môn học</span>
                        <strong style="color: var(--edu-text);">${data.courseCode}</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="font-xs d-block" style="color: var(--edu-muted);" data-i18n="questionBank.modalDoc">Tài liệu</span>
                        <strong style="color: var(--edu-text);">${data.documentName || '(Không liên kết)'}</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="font-xs d-block" style="color: var(--edu-muted);" data-i18n="questionBank.modalDiff">Độ khó</span>
                        <strong style="color: var(--edu-text);">${data.difficulty}</strong>
                    </div>
                </div>
            `;
            // Trigger translation since new dynamic content was added
            if (window.EduI18n && typeof window.EduI18n.applyLang === 'function') {
                window.EduI18n.applyLang(window.EduI18n.getLang());
            }
        }

        function confirmDelete(event, form) {
            event.preventDefault();
            const currentLang = (window.EduI18n && typeof window.EduI18n.getLang === 'function') ? window.EduI18n.getLang() : 'en';
            
            const title = currentLang === 'vi' ? 'Xác nhận xóa?' : 'Confirm Delete?';
            const text = currentLang === 'vi' 
                ? 'Hành động này sẽ xóa câu hỏi này khỏi ngân hàng câu hỏi. Nếu câu hỏi đã được dùng trong đề thi, hệ thống sẽ tự động hạ cấp xuống lưu trữ (Archived) để bảo toàn dữ liệu đề thi.'
                : 'This will delete the question from the question bank. If it is already used in a quiz, it will be archived to protect the quiz history.';
            const confirmText = currentLang === 'vi' ? 'Đồng ý' : 'Yes';
            const cancelText = currentLang === 'vi' ? 'Hủy' : 'Cancel';

            Swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: confirmText,
                cancelButtonText: cancelText,
                background: '#181c26',
                color: '#fff',
                customClass: {
                    popup: 'swal2-dark-custom shadow border'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        }
    </script>
}
