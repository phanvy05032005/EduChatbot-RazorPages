@page
@model EduChatbot.Web.Pages.Lecturer.QuestionBank.IndexModel
@{
    ViewData["Title"] = "Question Bank";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <span class="text-primary fw-bold text-uppercase fs-7 letter-spacing-1">Portal Ngân Hàng Đề</span>
            <h1 class="h2 fw-bold text-gray-900 m-0">Ngân Hàng Câu Hỏi</h1>
            <p class="text-muted m-0">Quản lý câu hỏi trắc nghiệm tự soạn hoặc được sinh tự động bằng AI từ tài liệu môn học.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Lecturer/Quizzes/Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i class="bi bi-card-checklist"></i> Quản lý đề trắc nghiệm
            </a>
            <a asp-page="./Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Thêm câu hỏi thủ công
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtering Toolbar Card -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-gray-700">Tìm kiếm câu hỏi</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" asp-for="Filter.SearchQuery" class="form-control bg-light border-start-0 ps-0" placeholder="Từ khóa câu hỏi, giải thích..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold text-gray-700">Môn học</label>
                    <select asp-for="Filter.CourseId" class="form-select bg-light" asp-items="@(new SelectList(Model.Courses, "Id", "Code"))">
                        <option value="">-- Tất cả môn --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold text-gray-700">Tài liệu nguồn</label>
                    <select asp-for="Filter.DocumentId" class="form-select bg-light" asp-items="@(new SelectList(Model.Documents, "Id", "FileName"))">
                        <option value="">-- Tất cả tài liệu --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold text-gray-700">Độ khó</label>
                    <select asp-for="Filter.Difficulty" class="form-select bg-light">
                        <option value="">-- Tất cả --</option>
                        <option value="Easy">Dễ (Easy)</option>
                        <option value="Medium">Trung bình (Medium)</option>
                        <option value="Hard">Khó (Hard)</option>
                    </select>
                </div>

                <div class="col-md-1">
                    <label class="form-label fw-semibold text-gray-700">Trạng thái</label>
                    <select asp-for="Filter.Status" class="form-select bg-light">
                        <option value="">-- Tất cả --</option>
                        <option value="Draft">Bản nháp</option>
                        <option value="Approved">Đã duyệt</option>
                        <option value="Archived">Đã lưu trữ</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-funnel-fill"></i> Lọc
                    </button>
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Main List Card -->
    <div class="card shadow-sm border-0 overflow-hidden bg-white">
        <div class="card-header bg-light py-3 d-flex align-items-center justify-content-between">
            <h5 class="m-0 fw-bold text-gray-800 d-flex align-items-center gap-2">
                <i class="bi bi-database-fill text-primary"></i> Danh sách câu hỏi (@Model.Questions.TotalCount)
            </h5>
            <div id="selection-toolbar" class="d-none">
                <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 shadow-sm" onclick="createQuizFromSelection()">
                    <i class="bi bi-magic"></i> Tạo bài trắc nghiệm từ câu hỏi đã chọn (<span id="select-count">0</span>)
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;" class="text-center">
                            <input type="checkbox" id="check-all" class="form-check-input" onclick="toggleSelectAll(this)" />
                        </th>
                        <th>Nội dung câu hỏi</th>
                        <th style="width: 120px;">Môn học</th>
                        <th style="width: 140px;">Độ khó</th>
                        <th style="width: 120px;">Trạng thái</th>
                        <th style="width: 140px;">Nguồn</th>
                        <th style="width: 160px;" class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Questions.Items.Any())
                    {
                        @foreach (var item in Model.Questions.Items)
                        {
                            <tr>
                                <td class="text-center">
                                    @if (item.Status != "Archived")
                                    {
                                        <input type="checkbox" name="selectedIds" value="@item.Id" class="form-check-input question-checkbox" onclick="updateSelectionCount()" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="form-check-input" disabled />
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-gray-900 text-truncate" style="max-width: 450px;" title="@item.QuestionText">
                                        @item.QuestionText
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Tags))
                                    {
                                        <div class="mt-1 d-flex gap-1 flex-wrap">
                                            @foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary font-xs rounded-1">@tag.Trim()</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                                        @item.CourseCode
                                    </span>
                                </td>
                                <td>
                                    @if (item.Difficulty == "Easy")
                                    {
                                        <span class="text-success fw-semibold"><i class="bi bi-circle-fill font-xs"></i> Dễ</span>
                                    }
                                    else if (item.Difficulty == "Medium")
                                    {
                                        <span class="text-warning fw-semibold"><i class="bi bi-circle-fill font-xs"></i> Trung bình</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold"><i class="bi bi-circle-fill font-xs"></i> Khó</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">Đã duyệt</span>
                                    }
                                    else if (item.Status == "Draft")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">Nháp</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-slate-subtle text-slate border border-slate-subtle rounded-pill px-2">Lưu trữ</span>
                                    }
                                </td>
                                <td>
                                    @if (item.SourceType == "AI")
                                    {
                                        <span class="text-info d-flex align-items-center gap-1 font-sm" title="Sinh từ tài liệu: @item.DocumentName">
                                            <i class="bi bi-cpu-fill"></i> AI Generated
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted d-flex align-items-center gap-1 font-sm">
                                            <i class="bi bi-person-fill"></i> Thủ công
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="showQuestionDetails(@item.Id)" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        @if (item.Status != "Archived")
                                        {
                                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirmDelete(event, this)">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-sm btn-outline-danger" disabled><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Chưa có câu hỏi nào được chọn hoặc tìm thấy phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (Model.Questions.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex align-items-center justify-content-between">
                <div class="font-sm text-muted">
                    Hiển thị trang @Model.Questions.Page trên tổng số @Model.Questions.TotalPages trang
                </div>
                <nav>
                    <ul class="pagination pagination-sm m-0">
                        <li class="page-item @(Model.Questions.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-page="./Index" asp-route-Filter.PageNumber="@(Model.Questions.Page - 1)"
                               asp-route-Filter.CourseId="@Model.Filter.CourseId" asp-route-Filter.DocumentId="@Model.Filter.DocumentId"
                               asp-route-Filter.Difficulty="@Model.Filter.Difficulty" asp-route-Filter.Status="@Model.Filter.Status"
                               asp-route-Filter.SearchQuery="@Model.Filter.SearchQuery">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.Questions.TotalPages; i++)
                        {
                            <li class="page-item @(Model.Questions.Page == i ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-Filter.PageNumber="@i"
                                   asp-route-Filter.CourseId="@Model.Filter.CourseId" asp-route-Filter.DocumentId="@Model.Filter.DocumentId"
                                   asp-route-Filter.Difficulty="@Model.Filter.Difficulty" asp-route-Filter.Status="@Model.Filter.Status"
                                   asp-route-Filter.SearchQuery="@Model.Filter.SearchQuery">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.Questions.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-page="./Index" asp-route-Filter.PageNumber="@(Model.Questions.Page + 1)"
                               asp-route-Filter.CourseId="@Model.Filter.CourseId" asp-route-Filter.DocumentId="@Model.Filter.DocumentId"
                               asp-route-Filter.Difficulty="@Model.Filter.Difficulty" asp-route-Filter.Status="@Model.Filter.Status"
                               asp-route-Filter.SearchQuery="@Model.Filter.SearchQuery">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="questionDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow border-0">
            <div class="modal-header py-3 bg-light">
                <h5 class="modal-title fw-bold text-gray-900" id="modalQuestionTitle">Chi tiết câu hỏi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalQuestionBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleSelectAll(checkbox) {
            const checkboxes = document.querySelectorAll('.question-checkbox');
            checkboxes.forEach(cb => cb.checked = checkbox.checked);
            updateSelectionCount();
        }

        function updateSelectionCount() {
            const selected = document.querySelectorAll('.question-checkbox:checked');
            const count = selected.length;
            const toolbar = document.getElementById('selection-toolbar');
            const selectCountSpan = document.getElementById('select-count');

            if (count > 0) {
                toolbar.classList.remove('d-none');
                selectCountSpan.textContent = count;
            } else {
                toolbar.classList.add('d-none');
                document.getElementById('check-all').checked = false;
            }
        }

        function createQuizFromSelection() {
            const selected = document.querySelectorAll('.question-checkbox:checked');
            const ids = Array.from(selected).map(cb => cb.value);
            
            // Build the URL to CreateQuiz with SelectedQuestionIds
            const query = ids.map(id => 'selectedIds=' + id).join('&');
            window.location.href = './QuestionBank/CreateQuiz?' + query;
        }

        async function showQuestionDetails(id) {
            const modal = new bootstrap.Modal(document.getElementById('questionDetailsModal'));
            modal.show();

            const body = document.getElementById('modalQuestionBody');
            body.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            `;

            try {
                const response = await fetch(`./QuestionBank/Details?id=${id}&handler=DetailsData`);
                if (!response.ok) {
                    throw new Error("Lỗi tải thông tin chi tiết");
                }
                const data = await response.json();
                renderDetails(data, body);
            } catch (err) {
                body.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
            }
        }

        function renderDetails(data, container) {
            let optionsHtml = '';
            data.options.forEach(opt => {
                optionsHtml += `
                    <div class="p-3 mb-2 rounded border border-light d-flex align-items-center gap-3 ${opt.isCorrect ? 'bg-success-subtle border-success-subtle text-success-emphasis fw-semibold' : 'bg-light'}">
                        <span class="badge bg-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;">${opt.label}</span>
                        <div>${opt.optionText}</div>
                        ${opt.isCorrect ? '<span class="ms-auto text-success font-xs text-uppercase fw-bold"><i class="bi bi-check-circle-fill"></i> Đúng</span>' : ''}
                    </div>
                `;
            });

            container.innerHTML = `
                <div class="mb-4">
                    <h6 class="fw-bold text-muted font-xs text-uppercase mb-2">Câu hỏi</h6>
                    <div class="fs-5 fw-semibold text-gray-900">${data.questionText}</div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted font-xs text-uppercase mb-2">Các phương án trả lời</h6>
                    ${optionsHtml}
                </div>

                ${data.explanation ? `
                <div class="mb-4 p-3 rounded bg-warning-subtle border border-warning-subtle">
                    <h6 class="fw-bold text-warning-emphasis font-xs text-uppercase mb-1"><i class="bi bi-chat-left-text-fill"></i> Giải thích</h6>
                    <p class="m-0 text-warning-emphasis font-sm">${data.explanation}</p>
                </div>
                ` : ''}

                <div class="row g-3 pt-3 border-top">
                    <div class="col-md-4">
                        <span class="text-muted font-xs d-block">Môn học</span>
                        <strong class="text-gray-900">${data.courseCode}</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted font-xs d-block">Tài liệu</span>
                        <strong class="text-gray-900">${data.documentName || '(Không liên kết)'}</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted font-xs d-block">Độ khó</span>
                        <strong class="text-gray-900">${data.difficulty}</strong>
                    </div>
                </div>
            `;
        }

        function confirmDelete(event, form) {
            event.preventDefault();
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: "Hành động này sẽ xóa câu hỏi này khỏi ngân hàng câu hỏi. Nếu câu hỏi đã được dùng trong đề thi, hệ thống sẽ tự động hạ cấp xuống lưu trữ (Archived) để bảo toàn dữ liệu đề thi.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        }
    </script>
}
