@page
@model EduChatbot.Web.Pages.Lecturer.QuestionBank.CreateQuizModel
@{
    ViewData["Title"] = "Tạo đề thi từ ngân hàng câu hỏi";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="./Index">Ngân hàng câu hỏi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tạo đề thi</li>
                </ol>
            </nav>

            <div class="card shadow border-0 overflow-hidden bg-white mb-4">
                <div class="card-header bg-light py-3 border-0">
                    <h4 class="m-0 fw-bold text-gray-900"><i class="bi bi-magic text-primary"></i> Tạo đề trắc nghiệm mới</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <!-- Keep selected question IDs -->
                        @for (int i = 0; i < Model.SelectedIds.Count; i++)
                        {
                            <input type="hidden" name="SelectedIds[@i]" value="@Model.SelectedIds[i]" />
                        }

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 font-sm"></div>

                        <!-- Title -->
                        <div class="mb-4">
                            <label asp-for="Input.Title" class="form-label fw-semibold">Tiêu đề đề thi <span class="text-danger">*</span></label>
                            <input asp-for="Input.Title" type="text" class="form-control bg-light" placeholder="Ví dụ: Kiểm tra giữa kỳ - Kỹ thuật lập trình" />
                            <span asp-validation-for="Input.Title" class="text-danger font-sm"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <!-- Course selection -->
                            <div class="col-md-4">
                                <label asp-for="Input.CourseId" class="form-label fw-semibold">Môn học <span class="text-danger">*</span></label>
                                <select asp-for="Input.CourseId" class="form-select bg-light" asp-items="@(new SelectList(Model.Courses, "Id", "Code"))">
                                    <option value="">-- Chọn môn học --</option>
                                </select>
                                <span asp-validation-for="Input.CourseId" class="text-danger font-sm"></span>
                            </div>

                            <!-- Time Limit -->
                            <div class="col-md-4">
                                <label asp-for="Input.TimeLimit" class="form-label fw-semibold">Thời gian làm bài (Phút) <span class="text-danger">*</span></label>
                                <input asp-for="Input.TimeLimit" type="number" class="form-control bg-light" />
                                <span asp-validation-for="Input.TimeLimit" class="text-danger font-sm"></span>
                            </div>

                            <!-- Max Attempts -->
                            <div class="col-md-4">
                                <label asp-for="Input.MaxAttempts" class="form-label fw-semibold">Số lượt thi tối đa <span class="text-danger">*</span></label>
                                <input asp-for="Input.MaxAttempts" type="number" class="form-control bg-light" />
                                <span asp-validation-for="Input.MaxAttempts" class="text-danger font-sm"></span>
                            </div>
                        </div>

                        <!-- Selected Questions Summary list -->
                        <h5 class="fw-bold text-gray-800 border-bottom pb-2 mb-3">Câu hỏi đã chọn (@Model.Questions.Count)</h5>
                        <div class="list-group mb-4" style="max-height: 400px; overflow-y: auto;">
                            @foreach (var q in Model.Questions)
                            {
                                <div class="list-group-item list-group-item-action border-light-subtle d-flex align-items-start gap-3 p-3">
                                    <span class="badge bg-secondary-subtle text-secondary font-xs mt-1">#@q.Id</span>
                                    <div class="flex-fill">
                                        <div class="fw-semibold text-gray-900 font-sm">@q.QuestionText</div>
                                        <div class="mt-1 d-flex gap-2">
                                            <span class="badge bg-light text-muted border font-xs">@q.CourseCode</span>
                                            <span class="badge bg-light text-muted border font-xs">@q.Difficulty</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-end gap-2 border-top pt-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4">Tạo đề trắc nghiệm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
