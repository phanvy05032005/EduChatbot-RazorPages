@page
@model EduChatbot.Web.Pages.Lecturer.QuestionBank.CreateQuizModel
@{
    ViewData["Title"] = "Tạo đề thi từ ngân hàng câu hỏi";
}

<style>
    .qb-input::placeholder {
        color: var(--edu-muted) !important;
        opacity: 0.95 !important;
    }
    .qb-input,
    .qb-select {
        background-color: rgba(228, 240, 246, 0.03) !important;
        border-color: var(--edu-border) !important;
        color: #ffffff !important;
    }
    .qb-input:focus,
    .qb-select:focus {
        background-color: rgba(228, 240, 246, 0.06) !important;
        border-color: #f59e0b !important;
        color: #ffffff !important;
        box-shadow: 0 0 0 0.2rem rgba(245, 158, 11, 0.25) !important;
    }
    .qb-select {
        background-image: url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3e%3cpath fill=%27none%27 stroke=%27%23ffffff%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27m2 5 6 6 6-6%27/%3e%3c/svg%3e') !important;
        background-repeat: no-repeat !important;
        background-position: right 0.75rem center !important;
        background-size: 8px 10px !important;
    }
</style>

<section class="role-page">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Breadcrumb -->
            <div style="margin-bottom: 1.5rem; font-size: 0.875rem;">
                <a asp-page="./Index" style="color: var(--edu-accent); text-decoration: none;" data-i18n="questionBank.title">Ngân hàng câu hỏi</a>
                <span style="color: var(--edu-soft); margin: 0 0.5rem;">/</span>
                <span style="color: var(--edu-muted);" data-i18n="questionBank.createQuiz.breadcrumb">Tạo đề thi</span>
            </div>

            <div class="role-form-card" style="padding: 2.25rem; border-radius: 12px; margin-bottom: 1.5rem; background: rgba(228, 240, 246, 0.02); border: 1px solid var(--edu-border);">
                <h3 class="fw-bold mb-4" style="color: var(--edu-text); font-weight: 300; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="bi bi-magic text-primary"></i> <span data-i18n="questionBank.createQuiz.header">Tạo đề trắc nghiệm mới</span>
                </h3>

                <form method="post">
                    <!-- Keep selected question IDs -->
                    @for (int i = 0; i < Model.SelectedIds.Count; i++)
                    {
                        <input type="hidden" name="SelectedIds[@i]" value="@Model.SelectedIds[i]" />
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 font-sm mb-4" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2) !important;"></div>

                    <!-- Title -->
                    <div class="mb-4">
                        <label asp-for="Input.Title" class="form-label fw-semibold" style="color: var(--edu-text);"><span data-i18n="questionBank.createQuiz.titleLabel">Tiêu đề đề thi</span> <span class="text-danger">*</span></label>
                        <input asp-for="Input.Title" type="text" class="form-control qb-input" placeholder="Ví dụ: Kiểm tra giữa kỳ - Kỹ thuật lập trình" data-i18n-placeholder="questionBank.createQuiz.titlePlaceholder" style="color: #fff;" />
                        <span asp-validation-for="Input.Title" class="text-danger font-sm mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <!-- Course selection -->
                        <div class="col-md-4">
                            <label asp-for="Input.CourseId" class="form-label fw-semibold" style="color: var(--edu-text);"><span data-i18n="questionBank.courseLabel">Môn học</span> <span class="text-danger">*</span></label>
                            <select asp-for="Input.CourseId" class="form-select qb-select" asp-items="@(new SelectList(Model.Courses, "Id", "Code"))">
                                <option value="" style="background: var(--edu-bg); color: #fff;" data-i18n="questionBank.createQuiz.selectCourseOption">-- Chọn môn học --</option>
                            </select>
                            <span asp-validation-for="Input.CourseId" class="text-danger font-sm mt-1 d-block"></span>
                        </div>

                        <!-- Time Limit -->
                        <div class="col-md-4">
                            <label asp-for="Input.TimeLimit" class="form-label fw-semibold" style="color: var(--edu-text);"><span data-i18n="questionBank.createQuiz.timeLimitLabel">Thời gian làm bài (Phút)</span> <span class="text-danger">*</span></label>
                            <input asp-for="Input.TimeLimit" type="number" class="form-control qb-input" style="color: #fff;" />
                            <span asp-validation-for="Input.TimeLimit" class="text-danger font-sm mt-1 d-block"></span>
                        </div>

                        <!-- Max Attempts -->
                        <div class="col-md-4">
                            <label asp-for="Input.MaxAttempts" class="form-label fw-semibold" style="color: var(--edu-text);"><span data-i18n="questionBank.createQuiz.maxAttemptsLabel">Số lượt thi tối đa</span> <span class="text-danger">*</span></label>
                            <input asp-for="Input.MaxAttempts" type="number" class="form-control qb-input" style="color: #fff;" />
                            <span asp-validation-for="Input.MaxAttempts" class="text-danger font-sm mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Selected Questions Summary list -->
                    <h5 class="fw-bold pb-2 mb-3" style="color: var(--edu-text); border-bottom: 1px solid var(--edu-border);"><span data-i18n="questionBank.createQuiz.selectedQuestionsTitle">Câu hỏi đã chọn</span> (@Model.Questions.Count)</h5>
                    <div class="list-group mb-4" style="max-height: 400px; overflow-y: auto; padding-right: 4px;">
                        @foreach (var q in Model.Questions)
                        {
                            <div class="list-group-item d-flex align-items-start gap-3 p-3" style="background: rgba(228, 240, 246, 0.01); border: 1px solid var(--edu-border); border-radius: 8px; margin-bottom: 0.5rem;">
                                <span class="badge" style="background: rgba(228, 240, 246, 0.08); color: var(--edu-muted); font-size: 0.75rem; align-self: flex-start; margin-top: 0.2rem;">#@q.Id</span>
                                <div class="flex-fill">
                                    <div class="fw-semibold font-sm text-white" style="line-height: 1.5;">@q.QuestionText</div>
                                    <div class="mt-2 d-flex gap-2">
                                        <span class="badge" style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2); font-size: 0.75rem; font-weight: 500;">@q.CourseCode</span>
                                        <span class="badge" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); font-size: 0.75rem; font-weight: 500;">@q.Difficulty</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Submit Buttons -->
                    <div class="d-flex justify-content-end gap-2" style="border-top: 1px solid var(--edu-border); padding-top: 1.5rem;">
                        <a asp-page="./Index" class="role-secondary-btn px-4" data-i18n="questionBank.createQuiz.cancelBtn">Hủy</a>
                        <button type="submit" class="role-primary-btn px-4" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border: none;" data-i18n="questionBank.createQuiz.submitBtn">Tạo đề trắc nghiệm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
